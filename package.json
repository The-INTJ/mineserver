{
  "name": "mineserver",
  "version": "0.1.0",
  "description": "Self-hosted Minecraft Fabric server manager: Node daemon + browser UI + MCP server",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": "github:The-INTJ/mineserver",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n daemon,ui -c blue,magenta \"npm:dev:daemon\" \"npm:dev:ui\"",
    "dev:daemon": "tsx watch src/server/main.ts",
    "daemon": "tsx src/server/main.ts",
    "play": "npm run build && node dist/server/main.js",
    "dev:ui": "vite --port 3401 --strictPort",
    "build": "npm run build:node && npm run build:ui",
    "build:node": "tsc -p tsconfig.node.json",
    "build:ui": "vite build",
    "start": "node dist/server/main.js",
    "mcp": "node dist/mcp/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"test/**/*.{ts,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"test/**/*.{ts,mjs}\"",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "archiver": "^8.0.0",
    "hono": "^4.13.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
